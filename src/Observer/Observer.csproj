<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ⚠ **WinExe にするのは、引数なしで画面を出すためである。**
         コンソールの exe だと、二重起動のたびに黒い窓が出る。
         **CLI は捨てていない。** 引数があれば呼び出した端末に繋ぎ直す（Gui.Attach） -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WGC（Windows.Graphics.Capture）を使うので Windows 10 1903 以降の投影が要る。
         配信ソフトと同じ経路で、ゲームのウィンドウだけを撮る（ADR-0067）。 -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>rematch-observer</AssemblyName>
    <RootNamespace>RematchObserver</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 単一 exe にしたときの展開を速くする。起動の速さは配布の前提（ADR-0067） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- PNG の読み書きと切り出しだけに使う。キャプチャには使わない。
         これを入れないと PNG のデコーダを自前で書くことになり、
         「小さく保つ」という前提（ADR-0067）と釣り合わない。 -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
